# ne-report-catchup.timer — daily 08:00 Europe/Vienna until umfeld has seen every KG (catchup.sh exits early then).
[Unit]
Description=Daily daytime NE catch-up (never-seen KGs)

[Timer]
OnCalendar=*-*-* 08:00:00 Europe/Vienna
RandomizedDelaySec=5min
Persistent=false

[Install]
WantedBy=timers.target
